<Project>
	<!-- 本地庫路徑屬性 TswgLibsDir，定義在倉庫根 TswgLibs.props。
		 前端專案取不到 Core 模組的 Directory.Build.props，故在此顯式導入。 -->
	<Import Project="$(MSBuildThisFileDirectory)../../TswgLibs.props" />

	<!-- 前端（Avalonia）共通設定。此檔是 MSBuild 對本目錄下所有專案找到的「最近一份」
		 Directory.Build.props，因此上層 Ngan.Ime.Core/proj/Directory.Build.props
		 對前端專案不會生效——凡是前端也需要、但那裡原本提供的東西，都要在本檔重新宣告。 -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- 全域不開 PublishAot：後端專案開了它，但前端只有桌面兩個頭要 NativeAOT，
			 Android 與 Browser 不支援該屬性（開著會讓還原去找桌面版 ILCompiler 套件）。
			 需要的頭各自在自己的 csproj 打開。 -->
		<PublishAot>false</PublishAot>

		<!-- Avalonia 版本只在這裡寫一次；各頭用 $(AvaloniaVersion) 引用，
			 避免五個專案各寫一個數字而漂移。 -->
		<AvaloniaVersion>12.0.4</AvaloniaVersion>
		<!-- Microsoft.Extensions.* 的版本同理。DI 必須 ≥ 10.0.8：
			 本地 CsKeyNode 宣告了這個下限，寫低了會被 NU1605 判成降級。 -->
		<MicrosoftExtensionsVersion>10.0.8</MicrosoftExtensionsVersion>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="$(MSBuildThisFileDirectory)TypeAlias.cs" />
		<Compile Include="$(MSBuildThisFileDirectory)GlobalUsing.cs" />
		<ProjectReference Include="$(MSBuildThisFileDirectory)../../Ngan.Ime.Core/proj/Ngan.Ime.Core/Ngan.Ime.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 依賴注入與日誌抽象：前端各層都可能用，版本集中在此。 -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
	</ItemGroup>
</Project>
