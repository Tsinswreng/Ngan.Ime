<Project>
	<!-- 本地庫路徑屬性 TswgLibsDir，定義在倉庫根 TswgLibs.props。
		 本模組只有一個專案，故具體引用寫在 Ngan.Ime.Rime.csproj；此檔只放全模組共同的編譯設定。 -->
	<Import Project="$(MSBuildThisFileDirectory)../../TswgLibs.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../TypeAlias.cs" />
		<Compile Include="../GlobalUsing.cs" />
	</ItemGroup>
</Project>
