<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- 桌面宿主是 Windows 上的正式入口，故只有它開 NativeAOT。 -->
		<PublishAot>true</PublishAot>
		<!-- NAudio WASAPI uses built-in COM interop; keep it enabled for the Windows prototype. -->
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
		<!--Condition below is needed to remove AvaloniaUI.DiagnosticsSupport package from build output in Release configuration.-->
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<!-- 只有 Windows 宿主採 WASAPI，故 NAudio 寫在這裡而不是前端共通 props。 -->
		<PackageReference Include="NAudio" Version="2.2.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- 管道協議契約：與外殼、測試共用同一份型別與解析器。 -->
		<Compile Include="$(MSBuildThisFileDirectory)../../_shared/TsfIpc.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- 機器私有配置（各機的 rime.dll 路徑不同，不進版控）：與 exe 同層。
		     服務端以「執行檔所在目錄」為儲存區根，故它必須被複製到輸出／發布目錄；
		     放在 csproj 裏，`dotnet run`／`dotnet publish`／打包腳本三條路都會自動帶上。
		     檔案由使用者自行準備（見 README）；沒有這個目錄時不會報錯。 -->
		<Content Include="$(MSBuildThisFileDirectory)ExternalRsrc.Private/**"
			CopyToOutputDirectory="PreserveNewest"
			CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ngan.Ime.UI\Ngan.Ime.UI.csproj" />
		<ProjectReference Include="..\..\Ngan.Ime.Rime\Ngan.Ime.Rime.csproj" />
		<ProjectReference Include="..\Ngan.Ime.Backend\Ngan.Ime.Backend.csproj" />
	</ItemGroup>

</Project>
