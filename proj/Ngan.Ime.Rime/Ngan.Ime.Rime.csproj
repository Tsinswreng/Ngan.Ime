	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../_shared/GlobalUsing.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- Core 抽象；Rime.Api 是原生 ABI 的托管鏡像（不在 TswgLib，故單獨引用）。 -->
		<ProjectReference Include="..\Ngan.Ime.Core\Ngan.Ime.Core.csproj" />
		<ProjectReference Include="..\..\..\CsRimeApi\proj\Rime.Api\Rime.Api.csproj" />
	</ItemGroup>

</Project>
